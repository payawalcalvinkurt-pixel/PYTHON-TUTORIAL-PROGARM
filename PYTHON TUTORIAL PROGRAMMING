def basic_syntax():
    while True:
        title("BASIC PYTHON SYNTAX")

        print("[1] Print Statement")
        print("[2] Variables")
        print("[3] Data Types")
        print("[4] Input Function")
        print("[5] Conditional Statements")
        print("[6] Loops")
        print("[7] Comments")
        print("[8] Logical Operators")
        print("[9] Return to Main Menu")

        choice = input("\nSelect a lesson: ")

        if choice == "1":
            title("PRINT STATEMENT")
            print("The print() function displays information.")
            print("\nExample:")
            print("print('Hello World!')")
            print("\nOutput:")
            print("Hello World!")
            pause()

        elif choice == "2":
            title("VARIABLES")
            print("Variables store information or values.")
            print("\nExample:")
            print("name = 'Calvin'")
            print("age = 20")
            print("print(name)")
            print("\nOutput:")
            print("Calvin")
            pause()

        elif choice == "3":
            title("DATA TYPES")
            print("Python has different data types:")
            print("\nString (str) - Text")
            print("Integer (int) - Whole numbers")
            print("Float (float) - Decimal numbers")
            print("Boolean (bool) - True or False")
            pause()

        elif choice == "4":
            title("INPUT FUNCTION")
            print("The input() function gets information")
            print("entered by the user.")
            print("\nExample:")
            print("name = input('Enter your name: ')")
            print("print(name)")
            pause()

        elif choice == "5":
            title("CONDITIONAL STATEMENTS")
            print("Conditional statements allow a program")
            print("to make decisions based on conditions.")
            print("\nExample:")
            print("if age >= 18:")
            print("    print('You are an adult.')")
            print("else:")
            print("    print('You are a minor.')")
            pause()

        elif choice == "6":
            title("LOOPS")
            print("Loops repeat a set of instructions.")
            print("\nTwo common types:")
            print("- for loop")
            print("- while loop")
            print("\nExample:")
            print("for number in range(5):")
            print("    print(number)")
            pause()

        elif choice == "7":
            title("COMMENTS")
            print("Comments are used to explain code.")
            print("\nExample:")
            print("# This is a single-line comment")
            print("\nComments are ignored by Python.")
            print("Triple quotes can also be used for")
            print("multiline strings and documentation.")
            pause()

        elif choice == "8":
            title("LOGICAL OPERATORS")
            print("Logical operators combine conditions.")
            print("\nAND - Both conditions must be True.")
            print("OR  - At least one must be True.")
            print("NOT - Reverses a Boolean result.")
            print("\nExamples:")
            print("True and False =", True and False)
            print("True or False  =", True or False)
            print("not True       =", not True)
            pause()

        elif choice == "9":
            break

        else:
            print("\nInvalid selection! Try again.")
            pause()


def arithmetic():
    while True:
        title("ARITHMETIC OPERATORS")

        print("[1] Addition (+)")
        print("[2] Subtraction (-)")
        print("[3] Multiplication (*)")
        print("[4] Division (/)")
        print("[5] Modulus (%)")
        print("[6] Return to Main Menu")

        choice = input("\nChoose an operator: ")

        if choice == "6":
            break

        if choice in ["1", "2", "3", "4", "5"]:
            first = float(input("\nEnter first number: "))
            second = float(input("Enter second number: "))

            if choice == "1":
                result = first + second
                symbol = "+"

            elif choice == "2":
                result = first - second
                symbol = "-"

            elif choice == "3":
                result = first * second
                symbol = "*"

            elif choice == "4":
                if second == 0:
                    print("\nCannot divide by zero!")
                    pause()
                    continue
                result = first / second
                symbol = "/"

            elif choice == "5":
                if second == 0:
                    print("\nCannot divide by zero!")
                    pause()
                    continue
                result = first % second
                symbol = "%"

            title("CALCULATION RESULT")
            print(f"{first} {symbol} {second} = {result}")
            pause()

        else:
            print("\nInvalid choice!")
            pause()


